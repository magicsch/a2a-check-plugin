# Local detection of sensitive content for the a2a-check preview (R-44, A-09).
#
# The shapes of catalog/patterns/credentials-1.1.0.yaml and
# catalog/patterns/personal-data-1.0.0.yaml (ids unchanged), written as POSIX
# extended regular expressions because the package is POSIX sh and grep only.
# One pattern per line: ID, TAB, flag (i = ignore case, - = exact), TAB, expression.
#
# Not covered locally: the three name patterns PII-005 to PII-007 (they need a
# case-sensitive group inside a case-insensitive phrase, which POSIX expressions
# cannot say) and the placeholder exceptions of the credential list, so the
# preview may show a hit the service would let pass. The preview shows where a
# pattern fired, never what it matched, and it neither replaces the filters of
# the service nor claims to find everything.
#
# Local copy of two versioned lists: a change of either catalog is a new version
# of this file, checked by tests/unit/test_reference_package.py.
CRED-001	-	sk-ant-[A-Za-z0-9_-]{16,}
CRED-002	-	sk-(proj-)?[A-Za-z0-9_-]{20,}
CRED-003	-	(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,}
CRED-004	-	(AKIA|ASIA)[0-9A-Z]{16}
CRED-005	-	AIza[0-9A-Za-z_-]{35}
CRED-006	-	xox[baprs]-[0-9A-Za-z-]{10,}
CRED-007	-	-----BEGIN (RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY( BLOCK)?-----
CRED-008	-	eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}
CRED-009	i	authorization[[:space:]]*[:=][[:space:]]*["']?bearer[[:space:]]+[A-Za-z0-9._-]{16,}
CRED-010	i	(password|passwd|pwd)[[:space:]]*[:=][[:space:]]*["']?[^][:space:]"'#,}]{6,}
CRED-011	i	(api[-_ ]?key|secret|access[-_ ]?token|auth[-_ ]?token|client[-_ ]?secret)[[:space:]]*[:=][[:space:]]*["']?[^][:space:]"'#,}]{12,}
CRED-012	i	(postgres(ql)?|mysql|mongodb(\+srv)?|redis|amqp)://[^:[:space:]/]+:[^@[:space:]]{4,}@
CRED-013	-	a2at_(ak|at|vt)_[A-Za-z0-9_-]{20,}
PII-001	-	[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}
PII-002	-	(^|[^A-Za-z0-9])[A-Z]{2}[0-9]{2}( ?[A-Za-z0-9]{4}){3,7}( ?[A-Za-z0-9]{1,3})?([^A-Za-z0-9]|$)
PII-003	-	(^|[^[:alnum:]_.])\+[1-9][0-9]{1,3}[ /-]?([0-9]{1,5}[ /-]?){1,5}[0-9]{2,}
PII-004	-	(^|[^[:alnum:]_.+])0[1-9][0-9]{1,4}[ /-][0-9]{3,}
